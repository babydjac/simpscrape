#!/bin/sh
set -e

SOURCE_PATH="$0"
while [ -h "$SOURCE_PATH" ]; do
  SOURCE_DIR=$(CDPATH= cd -P -- "$(dirname -- "$SOURCE_PATH")" && pwd)
  SOURCE_TARGET=$(readlink "$SOURCE_PATH")
  case "$SOURCE_TARGET" in
    /*) SOURCE_PATH="$SOURCE_TARGET" ;;
    *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_TARGET" ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -P -- "$(dirname -- "$SOURCE_PATH")" && pwd)
VENV_DIR="$SCRIPT_DIR/.venv"

# Keep dependencies isolated from Homebrew's externally managed Python.
if [ ! -x "$VENV_DIR/bin/python" ]; then
  python3 -m venv "$VENV_DIR"
fi

PYTHON_BIN="$VENV_DIR/bin/python"

if $PYTHON_BIN - <<'PY'
import importlib.util
missing = []
for mod in ("typer", "playwright"):
    if importlib.util.find_spec(mod) is None:
        missing.append(mod)
if missing:
    raise SystemExit(1)
PY
then
  true
else
  $PYTHON_BIN -m pip install -r "$SCRIPT_DIR/requirements.txt"
  $PYTHON_BIN -m playwright install chromium
fi

if $PYTHON_BIN - <<'PY'
import os
from playwright.sync_api import sync_playwright
with sync_playwright() as p:
    exe = p.chromium.executable_path
if not os.path.exists(exe):
    raise SystemExit(1)
PY
then
  true
else
  $PYTHON_BIN -m playwright install chromium
fi

if [ "$#" -eq 0 ]; then
  exec "$PYTHON_BIN" "$SCRIPT_DIR/cli.py" simp "$@"
fi

case "$1" in
  gui|universal-gui)
    shift
    if [ -d "$SCRIPT_DIR/gui/node_modules/electron" ]; then
      exec "$SCRIPT_DIR/gui/node_modules/.bin/electron" "$SCRIPT_DIR/gui" "$@"
    else
      exec "$PYTHON_BIN" "$SCRIPT_DIR/universal_gui.py" "$@"
    fi
    ;;
  run|simp|login|universal|chrome-bridge-install|chrome-bridge-info)
    SUBCOMMAND="$1"
    shift
    exec "$PYTHON_BIN" "$SCRIPT_DIR/cli.py" "$SUBCOMMAND" "$@"
    ;;
  --help|-h|help)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/cli.py" --help
    ;;
  *)
    exec "$PYTHON_BIN" "$SCRIPT_DIR/cli.py" simp "$@"
    ;;
esac
